{
  "manifest_version": 3,
  "name": "Sidekick AI",
  "version": "0.1.0",
  "description": "An AI buddy that flies around your screen and clicks through confusing websites for you",
  "permissions": ["sidePanel", "tabs", "tabGroups", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Sidekick AI"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/ghost-avatar.png"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ]
}
